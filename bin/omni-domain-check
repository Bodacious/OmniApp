#!/usr/bin/env ruby
# frozen_string_literal: true

# Checks that domain/ is plain Ruby that depends on nothing outside
# itself (its tests, in domain/test/, are not part of the domain):
#
# 1. MRI, started with --disable-gems, requires every domain file. Any
#    require of a gem, or of a library that is only a gem, fails.
# 2. Opal compiles every domain file with nothing but domain/ on its
#    load path, and Node runs the result through the use cases once.
#
# This is what CI runs; it needs `bundle install` (for Opal) and node.

require 'rbconfig'

ROOT = File.expand_path('..', __dir__)
DOMAIN = File.join(ROOT, 'domain')
files = Dir.glob('**/*.rb', base: DOMAIN).reject { |path| path.start_with?('test/') }.sort

puts "1/2 Loading #{files.size} domain files with ruby --disable-gems"
load_all = 'ARGV.each { |file| require file }; abort("RubyGems was loaded") if defined?(Gem)'
clean_env = { 'RUBYOPT' => nil, 'RUBYLIB' => nil, 'BUNDLE_GEMFILE' => nil, 'BUNDLE_BIN_PATH' => nil }
system(clean_env, RbConfig.ruby, '--disable-gems', '-e', load_all, *files.map { |f| File.join(DOMAIN, f) },
       exception: false) || abort('FAIL: domain/ needs something outside the Ruby standard library')

puts "2/2 Compiling domain/ alone with Opal and running it on Node"
require 'bundler/setup'
require 'fileutils'
require 'opal'

# A smoke run through every use case, with throwaway adapters written
# inline: nothing but the domain and Opal's corelib is on the path.
# (A non-interpolating heredoc: the #{} inside is for Opal, not MRI.)
SMOKE = <<~'RUBY'
  # Included after each port, so its methods come before the port's
  # abstract ones in the ancestor chain.
  module SmokeStore
    def items; @items ||= {}; end
    def find(id); items[id]; end
    def save(item); items[item.id] = item; end
    def delete(id); !items.delete(id).nil?; end
    def where; items.values.select { |item| yield item }; end
  end

  class SmokeUsers
    include Ports::UserRepository
    include SmokeStore
    def find_by_email(email); where { |user| user.email == email }.first; end
  end

  class SmokeLists
    include Ports::ListRepository
    include SmokeStore
    def owned_by(user_id); where { |list| list.owner_id == user_id }; end
  end

  class SmokeTodos
    include Ports::TodoRepository
    include SmokeStore
    def in_list(list_id); where { |todo| todo.list_id == list_id }; end
  end

  class SmokeHasher
    include Ports::PasswordHasher
    def digest(password); "smoke$#{password.reverse}"; end
    def matches?(password, digest); digest == "smoke$#{password.reverse}"; end
  end

  class SmokeIds
    include Ports::IdGenerator
    def initialize; @count = 0; end
    def next_id; @count += 1; "smoke-#{@count}"; end
  end

  def expect_invalid(what)
    yield
    raise "accepted #{what}"
  rescue InvalidInput, TodoService::NotFound
  end

  ids = SmokeIds.new
  accounts = Accounts.new(users: SmokeUsers.new, password_hasher: SmokeHasher.new, id_generator: ids)
  service = TodoService.new(lists: SmokeLists.new, todos: SmokeTodos.new, id_generator: ids)

  ada = accounts.sign_up(email: ' Ada@Example.com ', password: 'correct horse')
  raise 'sign in failed' unless accounts.sign_in(email: 'ada@example.com', password: 'correct horse') == ada
  expect_invalid('a wrong password') { accounts.sign_in(email: 'ada@example.com', password: 'nope nope') }
  expect_invalid('a short password') { accounts.sign_up(email: 'bob@example.com', password: 'short') }
  bob = accounts.sign_up(email: 'bob@example.com', password: 'another one')

  groceries = service.list(ada, service.create_list(ada, 'Groceries').id)
  milk = groceries.add('  Buy milk ', 'Errands, #Home')
  walk = groceries.add('Walk the dog', 'home')
  groceries.complete(milk.id)
  groceries.tag(milk.id, 'urgent')
  groceries.untag(milk.id, 'errands')
  groceries.delete(walk.id)
  expect_invalid('a blank title') { groceries.add('   ') }
  expect_invalid('a malformed tag') { groceries.add('Buy milk', 'not ok!') }
  expect_invalid('a sixth tag') { groceries.tag(milk.id, 'a b c d') }
  expect_invalid("someone else's list") { service.list(bob, groceries.id) }

  todos = groceries.todos(tagged: 'HOME').map { |todo| [todo.title, todo.completed?, todo.tags.map(&:name)] }
  raise "unexpected todos: #{todos.inspect}" unless todos == [['Buy milk', true, %w[home urgent]]]
  counts = groceries.tags.map { |count| [count.tag.name, count.todo_count] }
  raise "unexpected tag counts: #{counts.inspect}" unless counts == [['home', 1], ['urgent', 1]]
  raise 'bob can see lists' unless service.lists(bob).empty?
  service.delete_list(ada, groceries.id)
  raise 'list not deleted' unless service.lists(ada).empty?
  puts 'Opal: domain compiled and every use case ran'
RUBY

builder = Opal::Builder.new
builder.append_paths(DOMAIN)
builder.build('opal')
files.each { |file| builder.build(file.delete_suffix('.rb')) }
builder.build_str(SMOKE, 'domain_smoke.rb')

output = File.join(ROOT, 'tmp', 'domain-check.js')
FileUtils.mkdir_p(File.dirname(output))
File.write(output, builder.to_s)
system('node', output, exception: false) || abort('FAIL: the Opal-compiled domain did not run on Node')
puts 'PASS: domain/ is plain Ruby, loads without gems, and runs under Opal'
