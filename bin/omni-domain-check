#!/usr/bin/env ruby
# frozen_string_literal: true

# Checks that domain/ is plain Ruby that depends on nothing outside
# itself (its tests, in domain/test/, are not part of the domain):
#
# 1. MRI, started with --disable-gems, requires every domain file. Any
#    require of a gem, or of a library that is only a gem, fails.
# 2. Opal compiles every domain file with nothing but domain/ on its
#    load path, and Node runs the result through the model once.
#
# This is what CI runs; it needs `bundle install` (for Opal) and node.

require 'rbconfig'

ROOT = File.expand_path('..', __dir__)
DOMAIN = File.join(ROOT, 'domain')
files = Dir.glob('**/*.rb', base: DOMAIN).reject { |path| path.start_with?('test/') }.sort

puts "1/2 Loading #{files.size} domain files with ruby --disable-gems"
load_all = 'ARGV.each { |file| require file }; abort("RubyGems was loaded") if defined?(Gem)'
clean_env = { 'RUBYOPT' => nil, 'RUBYLIB' => nil, 'BUNDLE_GEMFILE' => nil, 'BUNDLE_BIN_PATH' => nil }
system(clean_env, RbConfig.ruby, '--disable-gems', '-e', load_all, *files.map { |f| File.join(DOMAIN, f) },
       exception: false) || abort('FAIL: domain/ needs something outside the Ruby standard library')

puts '2/2 Compiling domain/ alone with Opal and running it on Node'
require 'bundler/setup'
require 'fileutils'
require 'opal'

# A smoke run through the whole model, with throwaway repositories
# written inline: nothing but the domain and Opal's corelib is on the
# path. (A non-interpolating heredoc: the #{} inside is for Opal, not
# MRI.)
SMOKE = <<~'RUBY'
  # Included after each repository, so its methods come before the
  # abstract ones in the ancestor chain. Lists are kept as copies, as a
  # database would.
  module SmokeStore
    def items; @items ||= {}; end
    def next_identity; @count = (@count || 0) + 1; "smoke-#{@count}"; end
    def find(id); items[id]; end
    def save(item); items[item.id] = item; end
    def where; items.values.select { |item| yield item }; end
  end

  class SmokeUsers
    include UserRepository
    include SmokeStore
    def find_by_email(email); where { |user| user.email == email }.first; end
  end

  class SmokeLists
    include ListRepository
    include SmokeStore
    def copy(list); List.new(id: list.id, owner_id: list.owner_id, name: list.name, todos: list.todos); end
    def find(id); items[id] && copy(items[id]); end
    def save(list); items[list.id] = copy(list); list; end
    def owned_by(user); where { |list| list.owned_by?(user) }.map { |list| copy(list) }; end
    def remove(list); items.delete(list.id); nil; end
  end

  class SmokeHasher
    include PasswordHasher
    def digest(password); "smoke$#{password.reverse}"; end
    def matches?(password, digest); digest == "smoke$#{password.reverse}"; end
  end

  def expect_invalid(what)
    yield
    raise "accepted #{what}"
  rescue InvalidInput, NotFound
  end

  users = SmokeUsers.new
  lists = SmokeLists.new
  hasher = SmokeHasher.new

  ada = users.add(User.register(id: users.next_identity, email: ' Ada@Example.com ', password: 'correct horse',
                                hasher: hasher))
  raise 'sign in failed' unless users.account_for('ada@example.com').authenticate('correct horse', hasher) == ada
  expect_invalid('a wrong password') { users.account_for('ada@example.com').authenticate('nope nope', hasher) }
  expect_invalid('an unknown email') { users.account_for('who@example.com').authenticate('correct horse', hasher) }
  expect_invalid('a short password') { User.register(id: 'x', email: 'bob@example.com', password: 'short', hasher: hasher) }
  expect_invalid('a taken email') do
    users.add(User.register(id: users.next_identity, email: 'ada@example.com', password: 'another one', hasher: hasher))
  end
  bob = users.add(User.register(id: users.next_identity, email: 'bob@example.com', password: 'another one',
                                hasher: hasher))

  groceries = lists.save(List.new(id: lists.next_identity, owner_id: ada.id, name: 'Groceries'))
  groceries = lists.fetch(groceries.id, owner: ada)
  milk = groceries.add(id: lists.next_identity, title: '  Buy milk ', tags: 'Errands, #Home')
  walk = groceries.add(id: lists.next_identity, title: 'Walk the dog', tags: 'home')
  groceries.complete(milk.id)
  groceries.tag(milk.id, 'urgent')
  groceries.untag(milk.id, 'errands')
  groceries.remove(walk.id)
  expect_invalid('a blank title') { groceries.add(id: lists.next_identity, title: '   ') }
  expect_invalid('a malformed tag') { groceries.add(id: lists.next_identity, title: 'Buy milk', tags: 'not ok!') }
  expect_invalid('a sixth tag') { groceries.tag(milk.id, 'a b c d') }
  expect_invalid('a todo from elsewhere') { groceries.complete('elsewhere') }
  expect_invalid("someone else's list") { lists.fetch(groceries.id, owner: bob) }
  raise 'stored before it was saved' unless lists.find(groceries.id).todos.empty?
  lists.save(groceries)

  stored = lists.fetch(groceries.id, owner: ada)
  todos = stored.todos(tagged: 'HOME').map { |todo| [todo.title, todo.completed?, todo.tags.map(&:name)] }
  raise "unexpected todos: #{todos.inspect}" unless todos == [['Buy milk', true, %w[home urgent]]]
  counts = stored.tags.map { |count| [count.tag.name, count.todo_count] }
  raise "unexpected tag counts: #{counts.inspect}" unless counts == [['home', 1], ['urgent', 1]]
  raise 'bob can see lists' unless lists.owned_by(bob).empty?
  lists.remove(stored)
  raise 'list not removed' unless lists.owned_by(ada).empty?
  puts 'Opal: domain compiled and the whole model ran'
RUBY

builder = Opal::Builder.new
builder.append_paths(DOMAIN)
builder.build('opal')
files.each { |file| builder.build(file.delete_suffix('.rb')) }
builder.build_str(SMOKE, 'domain_smoke.rb')

output = File.join(ROOT, 'tmp', 'domain-check.js')
FileUtils.mkdir_p(File.dirname(output))
File.write(output, builder.to_s)
system('node', output, exception: false) || abort('FAIL: the Opal-compiled domain did not run on Node')
puts 'PASS: domain/ is plain Ruby, loads without gems, and runs under Opal'
