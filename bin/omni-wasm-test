#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the ruby_wasm app's browser specs (apps/ruby_wasm/features):
# serves the app with bin/omni-wasm on a free port, waits for it, runs
# Cucumber against it in headless Chrome, and stops the server.
# Arguments are passed to Cucumber. The same command runs in CI.
#
# These specs are separate from the stack matrix's (features/), which
# drive a server-side stack through /health and /__test__/reset. Here
# the whole stack runs in the browser, so each scenario starts from a
# fresh page instead.

require 'fileutils'
require 'net/http'
require 'socket'

ROOT = File.expand_path('..', __dir__)
BOOT_TIMEOUT = Integer(ENV.fetch('OMNI_BOOT_TIMEOUT', '60'))

port = TCPServer.open('127.0.0.1', 0) { |server| server.addr[1] }
base_url = "http://127.0.0.1:#{port}"
log_path = File.join(ROOT, 'tmp', 'omni-test', 'ruby_wasm.log')
FileUtils.mkdir_p(File.dirname(log_path))

def print_log(log_path)
  warn "\n----- server log (#{log_path}) -----"
  warn File.readlines(log_path).last(40).join
  warn '----- end of server log -----'
end

def serving?(base_url)
  Net::HTTP.get_response(URI("#{base_url}/manifest.json")).is_a?(Net::HTTPSuccess)
rescue SystemCallError, IOError, Net::ReadTimeout
  false
end

warn "bin/omni-wasm-test: serving the WebAssembly app on #{base_url}"
pid = Process.spawn({ 'PORT' => port.to_s, 'HOST' => '127.0.0.1' }, File.join(ROOT, 'bin', 'omni-wasm'),
                    chdir: ROOT, out: log_path, err: %i[child out], pgroup: true)

status = 1
begin
  deadline = Time.now + BOOT_TIMEOUT
  until serving?(base_url)
    if Process.waitpid(pid, Process::WNOHANG)
      print_log(log_path)
      abort 'bin/omni-wasm-test: the server exited before it was serving'
    end
    if Time.now > deadline
      print_log(log_path)
      abort "bin/omni-wasm-test: the server wasn't serving after #{BOOT_TIMEOUT}s"
    end
    sleep 0.25
  end

  cucumber_env = { 'OMNI_WASM_URL' => base_url, 'CUCUMBER_PUBLISH_QUIET' => 'true' }
  system(cucumber_env, 'bundle', 'exec', 'cucumber', '--require', 'apps/ruby_wasm/features',
         'apps/ruby_wasm/features', *ARGV, chdir: ROOT)
  status = $?.exitstatus || 1
  print_log(log_path) unless status.zero?
ensure
  begin
    Process.kill('TERM', -pid)
    50.times do
      break if Process.waitpid(pid, Process::WNOHANG)

      sleep 0.1
    end
    Process.kill('KILL', -pid)
  rescue Errno::ESRCH, Errno::ECHILD
    nil
  end
end

exit status
